{
  "name": "sgsi-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "verify:logic": "tsx scripts/verify-logic.ts",
    "setup": "npm install && prisma db push && npm run seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.4",
    "tsx": "4.16.2",
    "typescript": "5.5.2"
  }
}
